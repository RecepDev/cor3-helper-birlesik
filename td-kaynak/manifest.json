{
  "manifest_version": 3,
  "name": "COR3 TD Otomasyon",
  "version": "0.71.0",
  "description": "cor3.gg Tower Defense test otomasyonu",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "COR3 TD Otomasyon"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cor3.gg/*",
        "https://*.cor3.gg/*"
      ],
      "js": [
        "bot.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cor3.gg/*",
        "https://*.cor3.gg/*"
      ],
      "js": [
        "kopru.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js"
      ],
      "matches": [
        "https://cor3.gg/*",
        "https://*.cor3.gg/*"
      ]
    }
  ]
}
